---
const currentPath = Astro.url.pathname;

const DIRECTUS_URL = 'http://172.26.3.43:8055';
let categories = [];

try {
  const response = await fetch(`${DIRECTUS_URL}/items/posts?fields=category&limit=100`);
  if (response.ok) {
    const result = await response.json();
    const uniqueCategories = [...new Set(result.data.map(post => post.category).filter(Boolean))];
    categories = uniqueCategories.map(cat => ({
      name: cat,
      slug: cat.toLowerCase(),
      count: result.data.filter(post => post.category === cat).length
    }));
  }
} catch (error) {
  console.error('Error al obtener categorías:', error);
}
---

<header class="global-header" id="main-header">
  <div class="header-container">
    <a href="/" class="logo-link">
      <span class="logo-icon">⚡</span>
      <span class="logo-text">Se2Code</span>
      <span class="cursor-blink">_</span>
    </a>

    <nav class="nav-menu desktop-nav">
      <a href="/" class="nav-link" class:active={currentPath === '/'}>
        <span class="bracket">[</span> Home <span class="bracket">]</span>
      </a>
      
      <div class="nav-dropdown">
        <button class="nav-link dropdown-toggle">
          <span class="bracket">[</span> Artículos <span class="bracket">]</span>
          <span class="dropdown-arrow">▼</span>
        </button>
        <div class="dropdown-menu">
          <a href="/#articles" class="dropdown-item">
            <span class="item-icon">≡</span>
            <span class="item-text">Todos los artículos</span>
          </a>
          <div class="dropdown-divider"></div>
          {categories.map((cat) => (
            <a href={`/${cat.slug}`} class="dropdown-item">
              <span class="item-icon">&gt;</span>
              <span class="item-text">{cat.name}</span>
              <span class="item-count">{cat.count}</span>
            </a>
          ))}
        </div>
      </div>
      
      <a href="/contact" class="nav-link" class:active={currentPath === '/contact/'}>
        <span class="bracket">[</span> Contacto <span class="bracket">]</span>
      </a>
    </nav>

    <button class="terminal-toggle" aria-label="Abrir menú" aria-expanded="false">
      <span class="toggle-icon">>_</span>
    </button>
  </div>
  
  <div class="header-glow-line"></div>

  <div class="terminal-menu" id="terminalMenu">
    <div class="terminal-window">
      <div class="terminal-bar">
        <div class="terminal-dots">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <span class="terminal-title">~/se2code/nav.sh</span>
        <button class="terminal-close" aria-label="Cerrar menú">
          <span>[X]</span>
        </button>
      </div>

      <div class="terminal-content">
        <div class="terminal-line">
          <span class="prompt">$</span>
          <span class="command">./navigate --menu</span>
        </div>
        
        <nav class="terminal-nav">
          <a href="/" class="terminal-link" data-text="Home">
            <span class="link-prompt">→</span>
            <span class="link-text">cd /home</span>
          </a>
          
          <a href="/#articles" class="terminal-link" data-text="Artículos">
            <span class="link-prompt">→</span>
            <span class="link-text">cat ./artículos.md</span>
          </a>
          
          {categories.map((cat) => (
            <a href={`/${cat.slug}`} class="terminal-link" data-text={cat.name}>
              <span class="link-prompt">→</span>
              <span class="link-text">cd /{cat.slug}</span>
            </a>
          ))}
          
          <a href="/contact" class="terminal-link" data-text="Contacto">
            <span class="link-prompt">→</span>
            <span class="link-text">./contacto.sh --send</span>
          </a>
        </nav>

        <div class="terminal-footer">
          <span class="status">● System Ready</span>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Botón Scroll to Top -->
<button class="scroll-top-btn" id="scrollTopBtn" aria-label="Volver arriba">
  <span class="scroll-top-icon">↑</span>
  <span class="scroll-top-text">top</span>
</button>

<script is:inline>
  (function() {
    // === SCROLL TO TOP BUTTON ===
    var scrollTopBtn = document.getElementById('scrollTopBtn');
    var scrollThreshold = 400; // Aparece después de 400px de scroll
    
    function handleScrollTopVisibility() {
      if (!scrollTopBtn) return;
      
      if (window.scrollY > scrollThreshold) {
        scrollTopBtn.classList.add('visible');
      } else {
        scrollTopBtn.classList.remove('visible');
      }
    }

    function scrollToTop() {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    }

    if (scrollTopBtn) {
      scrollTopBtn.addEventListener('click', scrollToTop);
    }

    window.addEventListener('scroll', handleScrollTopVisibility, { passive: true });
    handleScrollTopVisibility();

    // === MENÚ TERMINAL ===
    var toggleBtn = document.querySelector('.terminal-toggle');
    var closeBtn = document.querySelector('.terminal-close');
    var terminalMenu = document.getElementById('terminalMenu');
    var terminalLinks = document.querySelectorAll('.terminal-link');
    var body = document.body;
    var dropdowns = document.querySelectorAll('.nav-dropdown');
    
    dropdowns.forEach(function(dropdown) {
      var toggle = dropdown.querySelector('.dropdown-toggle');
      var menu = dropdown.querySelector('.dropdown-menu');
      
      if (toggle && menu) {
        toggle.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          dropdowns.forEach(function(otherDropdown) {
            if (otherDropdown !== dropdown) {
              otherDropdown.classList.remove('active');
            }
          });
          
          dropdown.classList.toggle('active');
        });
        
        document.addEventListener('click', function(e) {
          if (!dropdown.contains(e.target)) {
            dropdown.classList.remove('active');
          }
        });
      }
    });
    
    function openMenu() {
      if (!terminalMenu) return;
      terminalMenu.classList.add('active');
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
      if (body) body.style.overflow = 'hidden';
      
      terminalLinks.forEach(function(link, index) {
        setTimeout(function() { 
          link.classList.add('visible'); 
        }, index * 100);
      });
    }

    function closeMenu() {
      if (!terminalMenu) return;
      terminalMenu.classList.remove('active');
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
      if (body) body.style.overflow = '';
      
      terminalLinks.forEach(function(link) { 
        link.classList.remove('visible'); 
      });
    }

    if (toggleBtn) toggleBtn.addEventListener('click', openMenu);
    if (closeBtn) closeBtn.addEventListener('click', closeMenu);
    
    terminalLinks.forEach(function(link) { 
      link.addEventListener('click', closeMenu); 
    });
    
    if (terminalMenu) {
      terminalMenu.addEventListener('click', function(e) {
        if (e.target === terminalMenu) closeMenu();
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && terminalMenu && terminalMenu.classList.contains('active')) {
        closeMenu();
      }
    });

    window.addEventListener('resize', function() {
      if (window.innerWidth > 768 && terminalMenu && terminalMenu.classList.contains('active')) {
        closeMenu();
      }
      dropdowns.forEach(function(dropdown) {
        dropdown.classList.remove('active');
      });
    });
  })();
</script>

<style>
  .global-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    width: 100%;
    background: rgba(10, 10, 10, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0, 255, 136, 0.25);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.8rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text, #e4e4e7);
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.25rem;
    font-weight: 700;
    transition: all 0.3s;
  }

  .logo-link:hover {
    color: var(--primary, #00ff88);
    text-shadow: 0 0 15px var(--glow, rgba(0, 255, 136, 0.4));
  }

  .logo-icon {
    font-size: 1.4rem;
    color: var(--primary, #00ff88);
    filter: drop-shadow(0 0 4px rgba(0, 255, 136, 0.5));
  }

  .cursor-blink {
    display: inline-block;
    color: var(--primary, #00ff88);
    animation: cursorBlink 1s step-end infinite;
    margin-left: 2px;
    font-weight: bold;
  }

  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .desktop-nav {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-link {
    position: relative;
    text-decoration: none;
    color: var(--text-light, #a1a1aa);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .nav-link .bracket {
    color: var(--border, #27272a);
    opacity: 0;
    transform: translateX(0);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover, .nav-link.active {
    color: var(--primary, #00ff88);
    text-shadow: 0 0 10px var(--glow, rgba(0, 255, 136, 0.3));
  }

  .nav-link:hover .bracket, .nav-link.active .bracket {
    opacity: 1;
    color: var(--primary, #00ff88);
  }

  .nav-link:hover .bracket:first-child { transform: translateX(-4px); }
  .nav-link:hover .bracket:last-child { transform: translateX(4px); }

  .nav-dropdown {
    position: relative;
  }

  .dropdown-toggle {
    cursor: pointer;
  }

  .dropdown-arrow {
    font-size: 0.6rem;
    margin-left: 4px;
    transition: transform 0.3s;
  }

  .nav-dropdown.active .dropdown-arrow {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    background: var(--bg-card, #1f1f23);
    border: 1px solid var(--primary, #00ff88);
    border-radius: 8px;
    min-width: 220px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    z-index: 1001;
    padding: 0.5rem 0;
  }

  .nav-dropdown.active .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    color: var(--text-light, #a1a1aa);
    text-decoration: none;
    transition: all 0.3s;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
  }

  .dropdown-item:hover {
    background: rgba(0, 255, 136, 0.1);
    color: var(--primary, #00ff88);
  }

  .item-icon {
    font-size: 1rem;
    color: var(--primary, #00ff88);
    font-weight: bold;
    width: 20px;
    text-align: center;
  }

  .item-text {
    flex: 1;
  }

  .item-count {
    background: var(--border, #27272a);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--text, #e4e4e7);
  }

  .dropdown-divider {
    height: 1px;
    background: var(--border, #27272a);
    margin: 0.5rem 0;
  }

  .terminal-toggle {
    display: none;
    background: var(--bg-card, #1f1f23);
    border: 1px solid var(--border, #27272a);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    transition: all 0.3s;
    font-family: 'JetBrains Mono', monospace;
    color: var(--primary, #00ff88);
    font-size: 1rem;
    font-weight: bold;
    z-index: 1001;
    position: relative;
  }

  .terminal-toggle:hover {
    background: var(--primary, #00ff88);
    color: var(--bg, #0a0a0a);
    border-color: var(--primary, #00ff88);
    box-shadow: 0 0 15px var(--glow, rgba(0, 255, 136, 0.4));
  }

  .toggle-icon { animation: pulse 2s ease-in-out infinite; }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  .terminal-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(10, 10, 10, 0.98);
    backdrop-filter: blur(20px);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .terminal-menu.active { 
    opacity: 1; 
    visibility: visible; 
  }

  .terminal-window {
    background: var(--bg-card, #1f1f23);
    border: 2px solid var(--primary, #00ff88);
    border-radius: 12px;
    width: 90%;
    max-width: 500px;
    max-height: 80vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0, 255, 136, 0.3);
    transform: translateY(-100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .terminal-menu.active .terminal-window { 
    transform: translateY(0); 
  }

  .terminal-bar {
    background: #111114;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border, #27272a);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .terminal-dots { display: flex; gap: 0.5rem; }
  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }

  .terminal-title {
    color: var(--text-light, #a1a1aa);
    font-size: 0.85rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .terminal-close {
    background: transparent;
    border: none;
    color: var(--text-light, #a1a1aa);
    cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    transition: all 0.3s;
    padding: 0.25rem 0.5rem;
  }

  .terminal-close:hover {
    color: #ff5f56;
    text-shadow: 0 0 10px rgba(255, 95, 86, 0.5);
  }

  .terminal-content { padding: 1.5rem; }

  .terminal-line {
    margin-bottom: 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
  }

  .prompt { color: var(--primary, #00ff88); font-weight: bold; margin-right: 0.5rem; }
  .command { color: var(--text, #e4e4e7); }

  .terminal-nav { display: flex; flex-direction: column; gap: 1rem; }

  .terminal-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text-light, #a1a1aa);
    font-family: 'JetBrains Mono', monospace;
    font-size: 1rem;
    padding: 0.75rem 1rem;
    background: var(--bg, #0a0a0a);
    border: 1px solid var(--border, #27272a);
    border-radius: 6px;
    transition: all 0.3s;
    opacity: 0;
    transform: translateX(-20px);
  }

  .terminal-link.visible { opacity: 1; transform: translateX(0); }

  .terminal-link:hover {
    background: var(--bg-card, #1f1f23);
    border-color: var(--primary, #00ff88);
    color: var(--primary, #00ff88);
    box-shadow: 0 0 15px rgba(0, 255, 136, 0.2);
    transform: translateX(5px);
  }

  .link-prompt { color: var(--primary, #00ff88); font-weight: bold; }

  .terminal-footer {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border, #27272a);
    text-align: center;
  }

  .status {
    color: var(--primary, #00ff88);
    font-size: 0.8rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .header-glow-line {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, 
      transparent 0%, 
      var(--primary, #00ff88) 20%, 
      var(--primary, #00ff88) 80%, 
      transparent 100%
    );
    box-shadow: 0 0 10px var(--primary, #00ff88), 0 0 20px var(--glow, rgba(0, 255, 136, 0.5));
    z-index: 1;
  }

  /* === SCROLL TO TOP BUTTON BRUTAL === */
  .scroll-top-btn {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 998;
    background: var(--bg-card, #1f1f23);
    border: 2px solid var(--primary, #00ff88);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    font-weight: bold;
    color: var(--primary, #00ff88);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px) scale(0.9);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .scroll-top-btn.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .scroll-top-btn:hover {
    background: var(--primary, #00ff88);
    color: var(--bg, #0a0a0a);
    border-color: var(--primary, #00ff88);
    box-shadow: 0 0 25px var(--glow, rgba(0, 255, 136, 0.5)), 0 8px 30px rgba(0, 0, 0, 0.5);
    transform: translateY(-3px) scale(1.05);
  }

  .scroll-top-btn:active {
    transform: translateY(0) scale(0.95);
  }

  .scroll-top-icon {
    font-size: 1.2rem;
    font-weight: bold;
    animation: bounceUp 2s ease-in-out infinite;
  }

  .scroll-top-btn:hover .scroll-top-icon {
    animation: none;
  }

  @keyframes bounceUp {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  .scroll-top-text {
    text-transform: lowercase;
    letter-spacing: 1px;
  }

  /* Efecto de "pulso" cuando aparece */
  .scroll-top-btn.visible::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    border: 2px solid var(--primary, #00ff88);
    border-radius: 8px;
    transform: translate(-50%, -50%);
    opacity: 0;
    animation: pulseRing 2s ease-out infinite;
  }

  @keyframes pulseRing {
    0% {
      width: 100%;
      height: 100%;
      opacity: 0.6;
    }
    100% {
      width: 140%;
      height: 140%;
      opacity: 0;
    }
  }

  @media (max-width: 768px) {
    .desktop-nav { display: none; }
    .terminal-toggle { display: block; }
    .header-container { padding: 0.8rem 1.5rem; }
    
    .scroll-top-btn {
      bottom: 1.5rem;
      right: 1.5rem;
      padding: 0.6rem 0.8rem;
      font-size: 0.75rem;
    }
  }
</style>
