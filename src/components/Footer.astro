</footer>

<style>
  .footer {
    background: var(--bg-alt, #18181b);
    color: var(--text-light, #a1a1aa);
    padding: 4rem 0 2rem;
    position: relative;
    overflow: hidden;
    font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace !important;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
    box-sizing: border-box;
  }

  .footer-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--primary, #00ff88), var(--secondary, #61dafb), var(--primary, #00ff88), transparent);
    background-size: 200% 100%;
    animation: gradient 4s ease infinite;
  }

  .footer-top {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border, #27272a);
  }

  .footer-terminal {
    background: var(--bg-card, #1f1f23);
    padding: 1.5rem 2rem;
    border-radius: 12px;
    border: 1px solid var(--border, #27272a);
    font-size: 0.95rem;
  }

  .footer-terminal .terminal-line {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .footer-terminal .prompt {
    color: var(--primary, #00ff88);
    font-weight: 700;
  }

  .footer-terminal .command {
    color: var(--text, #e4e4e7);
  }

  .footer-terminal .terminal-output {
    padding-left: 1.5rem;
    color: var(--text-light, #a1a1aa);
  }

  .footer-terminal .success {
    color: var(--primary, #00ff88);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-brand h3 {
    color: var(--text, #e4e4e7);
    font-size: 1.75rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo-icon {
    color: var(--primary, #00ff88);
    font-size: 1.5rem;
  }

  .footer-brand p {
    line-height: 1.8;
    margin-bottom: 1.5rem;
    color: var(--text-light, #a1a1aa);
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-icon {
    width: 44px;
    height: 44px;
    background: var(--bg-card, #1f1f23);
    border: 1px solid var(--border, #27272a);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-light, #a1a1aa);
    transition: all 0.3s;
  }

  .social-icon:hover {
    background: var(--primary, #00ff88);
    color: var(--bg, #0a0a0a);
    border-color: var(--primary, #00ff88);
    transform: translateY(-4px);
    box-shadow: 0 8px 20px var(--glow, rgba(0, 255, 136, 0.3));
  }

  .footer-links h4 {
    color: var(--primary, #00ff88);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .footer-links ul {
    list-style: none;
    padding: 0;
  }

  .footer-links li {
    margin-bottom: 0.75rem;
  }

  .footer-links a {
    color: var(--text-light, #a1a1aa);
    font-size: 0.95rem;
    transition: all 0.3s;
  }

  .footer-links a:hover {
    color: var(--primary, #00ff88);
    padding-left: 4px;
    text-shadow: 0 0 8px var(--glow, rgba(0, 255, 136, 0.3));
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid var(--border, #27272a);
  }

  .footer-bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-bottom p {
    font-size: 0.875rem;
    color: var(--text-light, #a1a1aa);
  }

  .footer-tech {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tech-badge {
    padding: 0.25rem 0.75rem;
    background: rgba(0, 255, 136, 0.1);
    border: 1px solid var(--border, #27272a);
    border-radius: 6px;
    font-size: 0.75rem;
    color: var(--primary, #00ff88);
    font-weight: 600;
    transition: all 0.3s;
  }

  .tech-badge:hover {
    border-color: var(--primary, #00ff88);
    box-shadow: 0 0 10px var(--glow, rgba(0, 255, 136, 0.3));
  }

  @media (max-width: 768px) {
    .footer {
      padding: 3rem 0 1.5rem;
    }
    
    .footer-container {
      padding: 0 1.5rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .footer-bottom-content {
      flex-direction: column;
      text-align: center;
    }
    
    .footer-tech {
      justify-content: center;
    }
  }
</style>
