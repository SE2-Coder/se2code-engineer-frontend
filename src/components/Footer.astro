      <div class="footer-links">
        <h4>Navegación</h4>
        <ul>
          <li><a href="/">→ Inicio</a></li>
          <li><a href="/#articles">→ Artículos</a></li>
          <li><a href="/#features">→ Stack</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h4>Recursos</h4>
        <ul>
          <li><a href="https://docs.directus.io" target="_blank">→ Directus</a></li>
          <li><a href="https://docs.astro.build" target="_blank">→ Astro</a></li>
          <li><a href="https://docs.docker.com" target="_blank">→ Docker</a></li>
          <li><a href="https://kubernetes.io/docs" target="_blank">→ Kubernetes</a></li>
        </ul>
      </div>

      <!-- CAMBIO 3: Correo actualizado a se2@se2code.engineer -->
      <div class="footer-links">
        <h4>Contacto</h4>
        <ul>
          <li><a href="mailto:se2@se2code.engineer">→ se2@se2code.engineer</a></li>
          <li><a href="#">→ Soporte</a></li>
          <li><a href="#">→ Colaborar</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom-content">
        <p>&copy; {new Date().getFullYear()} Se2Code Engineer. Todos los derechos reservados.</p>
        <div class="footer-tech">
          <span class="tech-badge">Astro</span>
          <span class="tech-badge">Directus</span>
          <span class="tech-badge">Docker</span>
          <span class="tech-badge">Traefik</span>
        </div>
      </div>
    </div>
